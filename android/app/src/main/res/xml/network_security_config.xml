<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The PC-hosted FastAPI is plain HTTP on LAN/Tailscale. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
