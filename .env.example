# EdgeStack environment configuration.
# Copy to `.env` and adjust. NEVER commit `.env` or real API keys.

# Hard safety default: EdgeStack is research / paper-trading software.
# There is no live-trading implementation in this repository; this flag exists
# so any future BrokerAdapter must be explicitly and deliberately enabled.
EDGESTACK_LIVE_TRADING_ENABLED=false

# Optional: override the config file used by the CLI.
# EDGESTACK_CONFIG=configs/default.yaml

# Optional indicative live-quote providers. Create accounts with the vendors;
# this repository cannot issue tokens. Any unconfigured provider is skipped and
# the default chain ends with the unofficial, no-key Yahoo fallback.
# EDGESTACK_FINNHUB_API_KEY=
# EDGESTACK_TWELVE_DATA_API_KEY=
# EDGESTACK_ALPACA_API_KEY_ID=
# EDGESTACK_ALPACA_API_SECRET_KEY=

# Continuous Edge Factory sources. Alpaca credentials also unlock authenticated
# historical bars (split-adjusted, paginated, SIP feed with a 16-minute cutoff).
# FRED is used with ALFRED real-time/vintage parameters. SEC asks applications
# to send a real organization/contact user-agent; do not use the placeholder.
# EDGESTACK_FRED_API_KEY=
# EDGESTACK_SEC_USER_AGENT=EdgeStack research your-email@example.com

# Provider order and operational thresholds (defaults shown).
EDGESTACK_LIVE_QUOTE_PROVIDERS=finnhub,twelvedata,alpaca,yahoo
EDGESTACK_LIVE_QUOTE_CACHE_TTL_SECONDS=5
EDGESTACK_LIVE_QUOTE_STALE_AFTER_SECONDS=120
EDGESTACK_LIVE_QUOTE_TIMEOUT_SECONDS=5
EDGESTACK_LIVE_QUOTE_COOLDOWN_SECONDS=60
EDGESTACK_LIVE_QUOTE_MAX_SYMBOLS=50
